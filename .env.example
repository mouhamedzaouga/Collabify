# Copiez ce fichier en `.env` (ou exportez les variables) avant de lancer le backend.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
COLLABIFY_SECRET_KEY=change-me
# COLLABIFY_DATABASE_URL=sqlite:///./collabify.db
# COLLABIFY_CORS_ORIGINS=http://localhost:8000
# COLLABIFY_TOKEN_MINUTES=480
# COLLABIFY_SEED_DEMO=1

# Code d'invitation exigé pour créer un compte Enseignant (fortement recommandé en production)
# COLLABIFY_TEACHER_CODE=choisissez-un-code-secret
# COLLABIFY_REGISTER_MAX=30
